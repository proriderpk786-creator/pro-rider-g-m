rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'prorider.pk786@gmail.com' ||
        request.auth.token.email == 'ProRider.pk786@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function parentThreadExists(userId, threadId) {
      return exists(/databases/$(database)/documents/users/$(userId)/aiThreads/$(threadId));
    }

    function parentPartnerAppExists(partnerId) {
      return exists(/databases/$(database)/documents/partnerApplications/$(partnerId));
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap: NO existing()/diff() inside!)
    // =========================================================================
    function isValidUserProfile(data, expectedUid) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'city', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'city', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role is string && data.role in ['passenger', 'partner']
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.preferredLang is string && data.preferredLang in ['en', 'ur']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, expectedUid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'whatsapp', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedPlace(data, expectedUid) {
      return data.keys().hasAll(['uid', 'label', 'address', 'lat', 'lng', 'category', 'createdAt'])
        && data.keys().hasOnly(['uid', 'label', 'address', 'lat', 'lng', 'category', 'placeId', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 300
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.category is string && data.category in ['home', 'work', 'university', 'favorite']
        && (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 200))
        && data.createdAt is timestamp;
    }

    function isValidAiThread(data, expectedUid) {
      return data.keys().hasAll(['uid', 'title', 'persona', 'mode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'persona', 'mode', 'lastMessagePreview', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.persona is string && data.persona in ['passenger', 'partner', 'general']
        && data.mode is string && data.mode in ['fast', 'general', 'deep']
        && (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiMessage(data, expectedUid, expectedThreadId) {
      return data.keys().hasAll(['uid', 'threadId', 'sender', 'text', 'mode', 'createdAt'])
        && data.keys().hasOnly(['uid', 'threadId', 'sender', 'text', 'mode', 'sources', 'places', 'createdAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.threadId is string && data.threadId.size() > 0 && data.threadId.size() <= 128 && data.threadId == expectedThreadId
        && data.sender is string && data.sender in ['user', 'assistant']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 8000
        && data.mode is string && data.mode in ['fast', 'general', 'deep', 'maps', 'search', 'voice']
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 10 && (data.sources.size() == 0 || data.sources[0] is map)))
        && (!('places' in data) || (data.places is list && data.places.size() <= 10 && (data.places.size() == 0 || data.places[0] is map)))
        && data.createdAt is timestamp;
    }

    function isValidSyncedBooking(data, expectedUid) {
      return data.keys().hasAll(['uid', 'bookingCode', 'bookingMode', 'serviceType', 'pickupAddress', 'dropoffAddress', 'distanceKm', 'farePkr', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'bookingCode', 'bookingMode', 'serviceType', 'pickupAddress', 'dropoffAddress', 'distanceKm', 'farePkr', 'status', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && isValidId(data.bookingCode)
        && data.bookingMode is string && data.bookingMode in ['go_now', 'schedule']
        && data.serviceType is string && data.serviceType in ['pick_and_drop', 'ride_sharing', 'fuel_sharing']
        && data.pickupAddress is string && data.pickupAddress.size() >= 1 && data.pickupAddress.size() <= 300
        && data.dropoffAddress is string && data.dropoffAddress.size() >= 1 && data.dropoffAddress.size() <= 300
        && data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 2000
        && data.farePkr is number && data.farePkr >= 0 && data.farePkr <= 10000000
        && data.status is string && data.status in ['searching', 'negotiating', 'confirmed', 'on_the_way', 'arrived', 'started', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerApplication(data, expectedUid) {
      return data.keys().hasAll(['uid', 'fullName', 'operatingCity', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'referencePhone',
          'cnicNumber', 'cnicExpiry', 'licenceNumber', 'licenceExpiry',
          'vehicleCategoryId', 'vehicleName', 'vehicleNumber', 'seatingCapacity', 'fuelType',
          'operatingCity', 'serviceEligibility', 'verificationStatus', 'adminNotes',
          'docsCount', 'submittedAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 180))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('referencePhone' in data) || (data.referencePhone is string && data.referencePhone.size() <= 32))
        && (!('cnicNumber' in data) || (data.cnicNumber is string && data.cnicNumber.size() <= 40))
        && (!('cnicExpiry' in data) || (data.cnicExpiry is string && data.cnicExpiry.size() <= 24))
        && (!('licenceNumber' in data) || (data.licenceNumber is string && data.licenceNumber.size() <= 60))
        && (!('licenceExpiry' in data) || (data.licenceExpiry is string && data.licenceExpiry.size() <= 24))
        && (!('vehicleCategoryId' in data) || (data.vehicleCategoryId is string && data.vehicleCategoryId.size() <= 64))
        && (!('vehicleName' in data) || (data.vehicleName is string && data.vehicleName.size() <= 120))
        && (!('vehicleNumber' in data) || (data.vehicleNumber is string && data.vehicleNumber.size() <= 40))
        && (!('seatingCapacity' in data) || (data.seatingCapacity is number && data.seatingCapacity >= 1 && data.seatingCapacity <= 30))
        && (!('fuelType' in data) || (data.fuelType is string && data.fuelType.size() <= 40))
        && data.operatingCity is string && data.operatingCity.size() >= 1 && data.operatingCity.size() <= 80
        && (!('serviceEligibility' in data) || (
          data.serviceEligibility is list
          && data.serviceEligibility.size() <= 3
          && (data.serviceEligibility.size() == 0 || data.serviceEligibility[0] is string)
        ))
        && data.verificationStatus is string
        && data.verificationStatus in ['incomplete', 'documents_pending', 'under_review', 'approved', 'rejected', 'suspended']
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!('docsCount' in data) || (data.docsCount is number && data.docsCount >= 0 && data.docsCount <= 12))
        && (!('submittedAt' in data) || (data.submittedAt is timestamp))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerApplicationDoc(data, expectedUid, expectedDocType) {
      return data.keys().hasAll(['uid', 'docType', 'fileName', 'fileDataUrl', 'status', 'uploadedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'docType', 'fileName', 'fileDataUrl', 'status',
          'expiryDate', 'reviewNotes', 'isPublic', 'uploadedAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == expectedUid
        && data.docType is string
        && data.docType in ['profile_photo', 'cnic_front', 'cnic_back', 'driving_licence', 'vehicle_registration', 'vehicle_photo']
        && data.docType == expectedDocType
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.fileDataUrl is string && data.fileDataUrl.size() >= 1 && data.fileDataUrl.size() <= 800000
        && data.status is string && data.status in ['pending', 'approved', 'rejected']
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 24))
        && (!('reviewNotes' in data) || (data.reviewNotes is string && data.reviewNotes.size() <= 400))
        && (!('isPublic' in data) || (data.isPublic is bool))
        && data.uploadedAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Server-managed Super Admin Registry (client writes strictly denied)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, write: if false;
    }

    // Pro Partner Verification Applications & Documents (Synced for Super Admin)
    match /partnerApplications/{partnerId} {
      allow get: if isValidId(partnerId) && (isOwner(partnerId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isValidId(partnerId)
        && isOwner(partnerId)
        && isValidPartnerApplication(incoming(), partnerId)
        && incoming().verificationStatus in ['incomplete', 'documents_pending', 'under_review']
        && !('adminNotes' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(partnerId)
        && isValidPartnerApplication(incoming(), partnerId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(partnerId)
            && existing().verificationStatus != 'suspended'
            && (
              incoming().verificationStatus in ['incomplete', 'documents_pending', 'under_review']
              || incoming().verificationStatus == existing().verificationStatus
            )
            && !incoming().diff(existing()).affectedKeys().hasAny(['adminNotes'])
          )
        );
      allow delete: if isValidId(partnerId) && isAdmin();

      match /documents/{docType} {
        allow get: if isValidId(partnerId) && isValidId(docType) && (isOwner(partnerId) || isAdmin());
        allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isValidId(partnerId) && isValidId(docType)
          && isOwner(partnerId)
          && parentPartnerAppExists(partnerId)
          && isValidPartnerApplicationDoc(incoming(), partnerId, docType)
          && incoming().status == 'pending'
          && !('reviewNotes' in incoming())
          && incoming().uploadedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(partnerId) && isValidId(docType)
          && isValidPartnerApplicationDoc(incoming(), partnerId, docType)
          && incoming().uid == existing().uid
          && incoming().docType == existing().docType
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(partnerId)
              && incoming().status == 'pending'
              && !incoming().diff(existing()).affectedKeys().hasAny(['reviewNotes'])
            )
          );
        allow delete: if isValidId(partnerId) && isValidId(docType) && isAdmin();
      }
    }

    // User Profiles (non-PII fields only)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'city', 'preferredLang', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Strictly isolated PII subcollection
      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId)
          && isOwner(userId)
          && parentUserExists(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'whatsapp', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
      }

      // Saved Pickup/Drop-off Locations
      match /savedPlaces/{placeId} {
        allow get: if isValidId(userId) && isValidId(placeId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(placeId)
          && isOwner(userId)
          && parentUserExists(userId)
          && isValidSavedPlace(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(placeId)
          && isValidSavedPlace(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'address', 'lat', 'lng', 'category', 'placeId'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(placeId) && (isOwner(userId) || isAdmin());
      }

      // AI Copilot Conversation Threads
      match /aiThreads/{threadId} {
        allow get: if isValidId(userId) && isValidId(threadId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(threadId)
          && isOwner(userId)
          && parentUserExists(userId)
          && isValidAiThread(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(threadId)
          && isValidAiThread(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'lastMessagePreview', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(threadId) && (isOwner(userId) || isAdmin());

        match /messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(threadId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
          allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
          allow create: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
            && isOwner(userId)
            && parentThreadExists(userId, threadId)
            && isValidAiMessage(incoming(), userId, threadId)
            && incoming().createdAt == request.time;
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(threadId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
        }
      }

      // Cloud-Synced Bookings Summary
      match /bookings/{bookingId} {
        allow get: if isValidId(userId) && isValidId(bookingId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (existing().uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(bookingId)
          && isOwner(userId)
          && parentUserExists(userId)
          && isValidSyncedBooking(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(bookingId)
          && isValidSyncedBooking(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().bookingCode == existing().bookingCode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && !(existing().status in ['completed', 'cancelled'])
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'farePkr', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isAdmin();
      }
    }
  }
}
