
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|sw\\.js|workbox-.*|manifest\\.webmanifest|icon\\.svg|apple-touch-icon\\.png|pwa-.*\\.png).*)",
      "destination": "/index.html"
    }
  ]
}

