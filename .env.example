# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens (HMAC-SHA256).
SESSION_SECRET="change-this-to-a-long-random-secret"

# ADMIN_BOOTSTRAP_PASSWORD: Initial password used to seed the Super Admin (ProRider.pk786@gmail.com).
ADMIN_BOOTSTRAP_PASSWORD="change-admin-password"

# SMS_PROVIDER_KEY: Optional SMS gateway API key for live OTP delivery.
SMS_PROVIDER_KEY=""
